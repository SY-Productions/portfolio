# Copy this file to .env and fill in the values
# .env is git-ignored — never commit secrets

# SQLite database path (relative to prisma/)
DATABASE_URL="file:./app.db"

# NextAuth — generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# GitHub — powers the dynamic Open Source section (pinned repos).
# Create a classic PAT with NO scopes checked (public data is enough):
# https://github.com/settings/tokens/new
GITHUB_TOKEN="ghp_your_read_only_token_here"
GITHUB_USERNAME="YOUSSSOF"
