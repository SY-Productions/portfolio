generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model WorkSample {
  id            Int     @id @default(autoincrement())
  isWeb         Boolean @default(true)
  faTitle       String
  enTitle       String
  faDescription String  @default("")
  enDescription String  @default("")
  pictures      String
  link          String
  technologys   String
  faStartDate   String
  enStartDate   String
  faEndDate     String
  enEndDate     String
}