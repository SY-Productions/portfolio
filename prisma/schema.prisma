// This is your Prisma schema file
// Learn more about it at https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id          Int     @id @default(1)
  themeA      String  @default("#5A0E12")
  themeB      String  @default("#3B070A")
  themeC      String  @default("#141010")
  themeD      String  @default("#8B1E24")
  totpSecret  String?
  profilePic  String  @default("/me.jpg")
  technologies String @default("Flutter,Dart,Python,FastAPI,Firebase,SQLite,Prisma,Next.js,React,TailwindCSS,GetX,BLoC,Retrofit,Figma,Git")
}

model WorkSample {
  id             Int     @id @default(autoincrement())
  isWeb          String
  faTitle        String
  enTitle        String
  arTitle        String  @default("")
  faDescription  String
  enDescription  String
  arDescription  String  @default("")
  pictures       String
  link           String
  technologys    String
  faStartDate    String
  enStartDate    String
  arStartDate    String  @default("")
  faEndDate      String
  enEndDate      String
  arEndDate      String  @default("")
  customLinks    String?
  client         String  @default("")
  order          Int     @default(0)
}

model Education {
  id            Int     @id @default(autoincrement())
  name          String
  nameEn        String  @default("")
  nameAr        String  @default("")
  fromYear      Int
  toYear        Int?
  picture       String
  description   String
  descriptionEn String  @default("")
  descriptionAr String  @default("")
  order         Int     @default(0)
}

model Work {
  id            Int     @id @default(autoincrement())
  name          String
  nameEn        String  @default("")
  nameAr        String  @default("")
  technos       String // Will store as JSON string
  fromYear      Int
  toYear        Int?
  picture       String
  url           String
  description   String
  descriptionEn String  @default("")
  descriptionAr String  @default("")
  order         Int     @default(0)
}

model Event {
  id            Int     @id @default(autoincrement())
  name          String
  nameEn        String  @default("")
  nameAr        String  @default("")
  date          String
  picture       String
  attachment    String
  description   String
  descriptionEn String  @default("")
  descriptionAr String  @default("")
  order         Int     @default(0)
}

model Product {
  id            Int     @id @default(autoincrement())
  title         String
  titleEn       String  @default("")
  titleAr       String  @default("")
  description   String
  descriptionEn String  @default("")
  descriptionAr String  @default("")
  url           String
  imageUrl      String  @default("")
  price         String  @default("")
  category      String  @default("theme")
  order         Int     @default(0)
}

model AdminSession {
  id          Int      @id @default(autoincrement())
  jti         String   @unique
  userAgent   String   @default("")
  ip          String   @default("")
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  isRevoked   Boolean  @default(false)
}

model PageView {
  id        Int      @id @default(autoincrement())
  path      String
  lang      String   @default("fa")
  createdAt DateTime @default(now())
}

model BlogCategory {
  id      Int        @id @default(autoincrement())
  name    String
  nameEn  String     @default("")
  nameAr  String     @default("")
  slug    String     @unique
  color   String     @default("#5A8EFF")
  posts   BlogPost[]
}

model BlogPost {
  id            Int           @id @default(autoincrement())
  slug          String        @unique

  title         String
  description   String
  content       String        @default("")
  keywords      String        @default("")

  titleEn       String        @default("")
  descriptionEn String        @default("")
  contentEn     String        @default("")
  keywordsEn    String        @default("")

  titleAr       String        @default("")
  descriptionAr String        @default("")
  contentAr     String        @default("")
  keywordsAr    String        @default("")

  coverImage    String        @default("")
  tags          String        @default("")
  tagsEn        String        @default("")
  tagsAr        String        @default("")
  authorName    String        @default("Yousof Hashemzade")

  categoryId    Int?
  category      BlogCategory? @relation(fields: [categoryId], references: [id])

  published     Boolean       @default(false)
  featured      Boolean       @default(false)
  readTime      Int           @default(5)
  views         Int           @default(0)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  publishedAt   DateTime?

  comments      BlogComment[]
}

model BlogComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  name      String
  email     String   @default("")
  content   String
  lang      String   @default("fa")

  createdAt DateTime @default(now())

  @@index([postId])
}
