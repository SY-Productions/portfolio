// This is your Prisma schema file
// Learn more about it at https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id          Int     @id @default(1)
  themeA      String  @default("#5A0E12")
  themeB      String  @default("#3B070A")
  themeC      String  @default("#141010")
  themeD      String  @default("#8B1E24")
  totpSecret  String?
  profilePic  String  @default("/me.jpg")
  technologies String @default("Flutter,Dart,Python,FastAPI,Firebase,SQLite,Prisma,Next.js,React,TailwindCSS,GetX,BLoC,Retrofit,Figma,Git")
}

model WorkSample {
  id             Int     @id @default(autoincrement())
  isWeb          String
  faTitle        String
  enTitle        String
  faDescription  String
  enDescription  String
  pictures       String
  link           String
  technologys    String
  faStartDate    String
  enStartDate    String
  faEndDate      String
  enEndDate      String
  customLinks    String?
  order          Int     @default(0)
}

model Education {
  id          Int     @id @default(autoincrement())
  name        String
  fromYear    Int
  toYear      Int?
  picture     String
  description String
  order       Int     @default(0)
}

model Work {
  id          Int     @id @default(autoincrement())
  name        String
  technos     String // Will store as JSON string
  fromYear    Int
  toYear      Int?
  picture     String
  url         String
  description String
  order       Int     @default(0)
}

model Event {
  id          Int     @id @default(autoincrement())
  name        String
  date        String
  picture     String
  attachment  String
  description String
  order       Int     @default(0)
}
